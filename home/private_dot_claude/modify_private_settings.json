#!/usr/bin/env bash
# chezmoi modify_ script for ~/.claude/settings.json.
#
# Claude Code writes this file too: `claude plugin install` mutates
# enabledPlugins, `/config` mutates theme and model. So chezmoi MERGES here
# rather than managing the whole file.
#
# Be precise about what that buys, because it is easy to overstate: theme and
# model are themselves in MANAGED below, so a `/config` change to either IS
# reverted on the next apply. That pinning is deliberate. What merging
# actually protects is every key dotfiles does NOT own — enabledPlugins
# (owned by run_onchange_after_10-install-claude-plugins.sh) and whatever a
# future Claude Code version adds. A plain managed file would delete those
# outright and sit permanently dirty in `chezmoi status`.
#
# Reads the current file on stdin, writes the desired file to stdout.
# Owns only the keys in MANAGED below; everything else passes through.
#
# "Owns" means add/update only, via jq's recursive `*` merge (see below) —
# it never deletes. This applies at every nesting level, so a nested map
# like extraKnownMarketplaces or statusLine only ever gains/overwrites keys
# here, never loses one. If a future edit retires an entry by removing it
# from MANAGED, already-provisioned machines keep the stale entry forever;
# `chezmoi diff`/`verify` will report clean and hide the staleness. Retiring
# something requires an explicit removal step elsewhere, not just deleting
# it from MANAGED.
#
# Malformed JSON on stdin is not special-cased: jq's parse failure exits
# non-zero, `set -euo pipefail` propagates that as this script's exit
# status, and chezmoi aborts without touching the destination file — no
# partial write, no corruption.
set -euo pipefail

# jq is declared in .chezmoidata/packages.toml and installed by
# run_onchange_before_01-install-packages.sh, which runs before this script.
# The guard covers a machine where that install was skipped or failed: this
# runs in chezmoi's file phase, ahead of every run_*_after_* script, so an
# unguarded jq failure here aborts `chezmoi init --apply` before the Claude
# CLI and plugins are ever installed.
if ! command -v jq >/dev/null 2>&1; then
    echo "modify_private_settings.json: jq is required but not installed" >&2
    exit 1
fi

MANAGED='{
  "effortLevel": "xhigh",
  "tui": "fullscreen",
  "theme": "dark",
  "model": "opus",
  "skipDangerousModePermissionPrompt": true,
  "statusLine": {
    "type": "command",
    "command": "ccstatusline",
    "padding": 0,
    "refreshInterval": 10
  },
  "extraKnownMarketplaces": {
    "prakashsurya-claude-plugins": {
      "source": { "source": "git", "url": "git@github.com:prakashsurya/claude-plugins.git" },
      "autoUpdate": true
    },
    "delphix-platform-team-claude-plugins": {
      "source": { "source": "github", "repo": "delphix/platform-team-claude-plugins" },
      "autoUpdate": true
    },
    "claude-plugins-official": {
      "source": { "source": "github", "repo": "anthropics/claude-plugins-official" }
    },
    "sec-governance-plugin": {
      "source": { "source": "github", "repo": "PerforceAI/sec-claude-governance" }
    }
  }
}'

current=$(cat)

# Fresh machine: chezmoi passes empty stdin when the target does not exist.
if [ -z "${current//[[:space:]]/}" ]; then
    current='{}'
fi

# `*` is jq's recursive merge; the right operand wins on conflicts, so
# MANAGED overrides while unmanaged keys survive.
printf '%s' "$current" | jq --argjson managed "$MANAGED" '. * $managed'
