# Ignore patterns for files that should not be deployed to $HOME.
# See: https://www.chezmoi.io/reference/special-files/chezmoiignore/

# ~/.claude runtime state and secrets — never track these.
# Guards against a future `chezmoi add ~/.claude` sweeping them in.
.claude/.credentials.json
.claude/.claude.json
.claude/.last-cleanup
.claude/.last-update-result.json
.claude/history.jsonl
.claude/policy-limits.json
.claude/remote-settings.json
.claude/stats-cache.json
.claude/projects/
.claude/sessions/
.claude/session-env/
.claude/file-history/
.claude/shell-snapshots/
.claude/backups/
.claude/paste-cache/
.claude/cache/
.claude/tasks/
.claude/plugins/
.claude/governance-logs/
.claude/voice/
# handoffs/ are branch-scoped session notes; they carry customer/support-case
# detail, internal hostnames and RFC1918 addresses, and this repo is PUBLIC.
.claude/handoffs/
