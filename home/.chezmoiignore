{{- template "profile-guard" . }}

# Each machine gets only its own profile's ~/.claude/profile/<name>.md,
# which ~/.claude/CLAUDE.md imports.
.claude/profile/*
!.claude/profile/{{ .profile }}.md

{{- if ne .profile "delphix" }}
# Delphix-only files and install scripts. Scripts are matched by target
# name, as `chezmoi managed --include=scripts` prints it.
.onelogin-aws.config
.local/bin/update-team-claude-plugins
.claude/conventions/dlpx-qa-gate.md
.claude/conventions/knowledge-graph.md
.claude/conventions/platform-team-claude-plugins.md
.chezmoiscripts/always_after_07-pin-git-utils-python.sh
.chezmoiscripts/12-install-team-plugins-cron.sh
.chezmoiscripts/13-install-session-manager-plugin.sh
{{- end }}

# Ignore patterns for files that should not be deployed to $HOME.
# See: https://www.chezmoi.io/reference/special-files/chezmoiignore/

# ~/.claude runtime state and secrets — never track these.
# Guards against a future `chezmoi add ~/.claude` sweeping them in.
.claude/.credentials.json
.claude/.claude.json
.claude/.last-cleanup
.claude/.last-update-result.json
.claude/history.jsonl
.claude/policy-limits.json
.claude/remote-settings.json
.claude/stats-cache.json
.claude/projects/
.claude/sessions/
.claude/session-env/
.claude/file-history/
.claude/shell-snapshots/
.claude/backups/
.claude/paste-cache/
.claude/cache/
.claude/tasks/
.claude/plugins/
.claude/governance-logs/
.claude/voice/
# handoffs/ are branch-scoped session notes; they carry customer/support-case
# detail, internal hostnames and RFC1918 addresses, and this repo is PUBLIC.
.claude/handoffs/
