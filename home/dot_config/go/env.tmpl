# Go's own config file (what `go env -w` writes), read by every go command
# regardless of shell, including the install scripts under bash. Keeps
# GOPATH (the module cache in pkg/mod, and `go install` output) out of the
# default ~/go. The build cache already follows XDG (~/.cache/go-build).
GOPATH={{ joinPath .chezmoi.homeDir ".local" "share" "go" }}
